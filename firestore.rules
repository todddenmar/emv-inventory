rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        userDoc().data.role in ['master-admin', 'admin', 'owner', 'manager', 'cashier'];
    }

    function isMasterAdmin() {
      return isSignedIn() &&
        userDoc().data.role == 'master-admin';
    }

    function isElevatedAdmin() {
      return isSignedIn() &&
        userDoc().data.role in ['master-admin', 'admin'];
    }

    function isOwner() {
      return isSignedIn() &&
        userDoc().data.role == 'owner';
    }

    function canReadAllBranches() {
      return isElevatedAdmin() || isOwner();
    }

    function managerBranchId() {
      return userDoc().data.branchId;
    }

    // Elevated only — owners are read-only and must not pass write checks.
    function canAccessBranch(branchId) {
      return isElevatedAdmin() || managerBranchId() == branchId;
    }

    function isOnlineShopBranch(branchId) {
      let branch = get(/databases/$(database)/documents/branches/$(branchId));
      return branch.data.isOnlineShop == true && branch.data.isActive == true;
    }

    // Shared auth collections
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isStaff();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow update: if isElevatedAdmin();
    }

    match /settings/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/settings/bootstrap);
      allow update: if isMasterAdmin();
    }

    match /settings/app {
      allow read: if isStaff();
      allow create, update: if isElevatedAdmin();
      allow delete: if false;
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isElevatedAdmin();
      allow update: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Online shop collections (no physical prefix)
    // -------------------------------------------------------------------------

    match /settings/site {
      allow read: if true;
      allow write: if isElevatedAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isElevatedAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isElevatedAdmin();
    }

    match /branches/{branchId} {
      allow read: if resource.data.isActive == true;
      allow read: if isStaff() && canAccessBranch(branchId);
      allow read: if canReadAllBranches();
      allow write: if isElevatedAdmin();
    }

    match /branchInventory/{inventoryId} {
      allow read: if resource.data.branchId != null &&
        isOnlineShopBranch(resource.data.branchId);
      allow read: if resource.data.branchId != null &&
        (canReadAllBranches() || managerBranchId() == resource.data.branchId);
      allow read: if canReadAllBranches();
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow update: if isStaff() &&
        resource.data.branchId != null &&
        canAccessBranch(resource.data.branchId);
      allow update: if isSignedIn() &&
        resource.data.branchId != null &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock;
      allow delete: if isElevatedAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
          (isStaff() &&
            (canReadAllBranches() || resource.data.branchId == managerBranchId())));
      allow update: if isStaff() &&
        (isElevatedAdmin() || resource.data.branchId == managerBranchId());
    }

    match /homeBanners/{bannerId} {
      allow read: if true;
      allow write: if isElevatedAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isElevatedAdmin();
    }

    match /inventoryLogs/{logId} {
      allow read: if isStaff() &&
        (canReadAllBranches() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow create: if isSignedIn() &&
        request.resource.data.reason == 'order_sale' &&
        request.resource.data.delta < 0;
      allow update, delete: if false;
    }

    match /branchTransfers/{transferId} {
      allow read: if isStaff() &&
        (canReadAllBranches() ||
          resource.data.fromBranchId == managerBranchId() ||
          resource.data.toBranchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.fromBranchId != null &&
        canAccessBranch(request.resource.data.fromBranchId);
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Physical inventory collections (physical* prefix)
    // -------------------------------------------------------------------------

    match /physicalProducts/{productId} {
      allow read: if isStaff();
      allow write: if isElevatedAdmin();
    }

    match /physicalCategories/{categoryId} {
      allow read: if isStaff();
      allow write: if isElevatedAdmin();
    }

    match /physicalCategoryGroups/{groupId} {
      allow read: if isStaff();
      allow write: if isElevatedAdmin();
    }

    match /physicalVendors/{vendorId} {
      allow read: if isStaff();
      allow write: if isElevatedAdmin();
    }

    match /physicalBranches/{branchId} {
      allow read: if isStaff();
      allow write: if isElevatedAdmin();
    }

    match /physicalBranchInventory/{inventoryId} {
      // Staff can read all branches (cashier cross-branch stock check).
      allow read: if isStaff();
      // Staff may create/update any branch row so transfer completion can
      // adjust source and destination stock in one client transaction.
      allow create: if isStaff() && request.resource.data.branchId != null;
      allow update: if isStaff() && resource.data.branchId != null;
      allow delete: if isElevatedAdmin();
    }

    match /physicalInventoryLogs/{logId} {
      allow read: if isStaff() &&
        (canReadAllBranches() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        (canAccessBranch(request.resource.data.branchId) ||
          request.resource.data.reason in ['transfer_out', 'transfer_in']);
      allow update, delete: if false;
    }

    match /physicalProductPriceLogs/{logId} {
      allow read: if isStaff();
      allow create: if isElevatedAdmin();
      allow update, delete: if false;
    }

    match /physicalBranchTransfers/{transferId} {
      allow read: if isStaff() &&
        (canReadAllBranches() ||
          resource.data.fromBranchId == managerBranchId() ||
          resource.data.toBranchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.fromBranchId != null &&
        (canAccessBranch(request.resource.data.fromBranchId) ||
          canAccessBranch(request.resource.data.toBranchId));
      allow update, delete: if false;
    }

    match /physicalTransferRequests/{requestId} {
      // Staff may list/read all requests so branch-scoped listeners work.
      // Writes stay constrained to the involved branch below.
      allow read: if isStaff();
      allow create: if isStaff() &&
        request.resource.data.status == 'requested' &&
        request.resource.data.toBranchId == managerBranchId() &&
        request.resource.data.fromBranchId != request.resource.data.toBranchId &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0;
      allow update: if isStaff() &&
        (resource.data.fromBranchId == managerBranchId() ||
          resource.data.toBranchId == managerBranchId()) &&
        (
          // Source: release or decline while requested
          (resource.data.fromBranchId == managerBranchId() &&
            resource.data.status == 'requested' &&
            request.resource.data.status in ['released', 'declined']) ||
          // Source: undo release or undo decline → back to requested
          (resource.data.fromBranchId == managerBranchId() &&
            resource.data.status in ['released', 'declined'] &&
            request.resource.data.status == 'requested') ||
          // Requester: cancel while requested
          (resource.data.toBranchId == managerBranchId() &&
            resource.data.status == 'requested' &&
            request.resource.data.status == 'cancelled') ||
          // Requester: receive after released (stock move happens in same client tx)
          (resource.data.toBranchId == managerBranchId() &&
            resource.data.status == 'released' &&
            request.resource.data.status == 'completed')
        );
      allow delete: if false;
    }

    match /physicalPosSales/{saleId} {
      allow read: if isStaff() &&
        (canReadAllBranches() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      // Admins may correct tender / account details after a sale is completed.
      allow update: if isElevatedAdmin();
      allow delete: if false;
    }

    match /physicalDailyExpenses/{expenseId} {
      allow read: if isStaff() &&
        (canReadAllBranches() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        (canReadAllBranches() ||
          canAccessBranch(request.resource.data.branchId));
      allow delete: if isStaff() &&
        (canReadAllBranches() ||
          canAccessBranch(resource.data.branchId));
      allow update: if false;
    }

    match /physicalDailyCashRecords/{recordId} {
      allow read: if isStaff() &&
        (resource == null ||
          canReadAllBranches() ||
          resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        (canReadAllBranches() ||
          canAccessBranch(request.resource.data.branchId));
      allow update: if isStaff() &&
        (canReadAllBranches() ||
          canAccessBranch(resource.data.branchId));
      allow delete: if isElevatedAdmin();
    }

    match /physicalSupplierStockIns/{stockInId} {
      allow read: if isStaff() &&
        (canReadAllBranches() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow update, delete: if false;
    }

    match /physicalResellers/{resellerId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isElevatedAdmin();
    }

    match /physicalPaymentAccounts/{accountId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isElevatedAdmin();
    }

    match /physicalPaymentMethods/{methodId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isElevatedAdmin();
    }

    match /physicalVouchers/{voucherId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if false;
    }

    match /physicalPricePromotions/{promotionId} {
      allow read: if isStaff();
      allow create, update: if isElevatedAdmin();
      allow delete: if isElevatedAdmin();
    }
  }
}
