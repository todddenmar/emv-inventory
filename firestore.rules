rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        userDoc().data.role in ['master-admin', 'manager'];
    }

    function isMasterAdmin() {
      return isSignedIn() &&
        userDoc().data.role == 'master-admin';
    }

    function managerBranchId() {
      return userDoc().data.branchId;
    }

    function canAccessBranch(branchId) {
      return isMasterAdmin() || managerBranchId() == branchId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isStaff();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow update: if isMasterAdmin();
    }

    match /settings/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/settings/bootstrap);
      allow update: if isMasterAdmin();
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isMasterAdmin();
      allow update: if isSignedIn();
    }

    match /physicalProducts/{productId} {
      allow read: if isStaff();
      allow write: if isMasterAdmin();
    }

    match /physicalCategories/{categoryId} {
      allow read: if isStaff();
      allow write: if isMasterAdmin();
    }

    match /physicalVendors/{vendorId} {
      allow read: if isStaff();
      allow write: if isMasterAdmin();
    }

    match /physicalBranches/{branchId} {
      allow read: if isStaff();
      allow write: if isMasterAdmin();
    }

    match /physicalBranchInventory/{inventoryId} {
      allow read: if resource.data.branchId != null &&
        (isMasterAdmin() || managerBranchId() == resource.data.branchId);
      allow read: if isMasterAdmin();
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow update: if isStaff() &&
        resource.data.branchId != null &&
        canAccessBranch(resource.data.branchId);
      allow delete: if isMasterAdmin();
    }

    match /physicalInventoryLogs/{logId} {
      allow read: if isStaff() &&
        (isMasterAdmin() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow update, delete: if false;
    }

    match /physicalBranchTransfers/{transferId} {
      allow read: if isStaff() &&
        (isMasterAdmin() ||
          resource.data.fromBranchId == managerBranchId() ||
          resource.data.toBranchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.fromBranchId != null &&
        canAccessBranch(request.resource.data.fromBranchId);
      allow update, delete: if false;
    }
  }
}
