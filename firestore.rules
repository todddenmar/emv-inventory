rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        userDoc().data.role in ['master-admin', 'manager'];
    }

    function isMasterAdmin() {
      return isSignedIn() &&
        userDoc().data.role == 'master-admin';
    }

    function managerBranchId() {
      return userDoc().data.branchId;
    }

    function canAccessBranch(branchId) {
      return isMasterAdmin() || managerBranchId() == branchId;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isStaff();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow update: if isMasterAdmin();
    }

    match /settings/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/settings/bootstrap);
      allow update: if isMasterAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /branches/{branchId} {
      allow read: if isStaff() && canAccessBranch(branchId);
      allow write: if isMasterAdmin();
    }

    match /branchInventory/{inventoryId} {
      allow read: if resource.data.branchId != null &&
        (isMasterAdmin() || managerBranchId() == resource.data.branchId);
      allow read: if isMasterAdmin();
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow update: if isStaff() &&
        resource.data.branchId != null &&
        canAccessBranch(resource.data.branchId);
      allow update: if isSignedIn() &&
        resource.data.branchId != null &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock;
      allow delete: if isMasterAdmin();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() &&
        (resource.data.customerId == request.auth.uid ||
          (isStaff() &&
            (isMasterAdmin() || resource.data.branchId == managerBranchId())));
      allow update: if isStaff() &&
        (isMasterAdmin() || resource.data.branchId == managerBranchId());
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isMasterAdmin();
      allow update: if isSignedIn();
    }

    match /homeBanners/{bannerId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /inventoryLogs/{logId} {
      allow read: if isStaff() &&
        (isMasterAdmin() || resource.data.branchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.branchId != null &&
        canAccessBranch(request.resource.data.branchId);
      allow create: if isSignedIn() &&
        request.resource.data.reason == 'order_sale' &&
        request.resource.data.delta < 0;
      allow update, delete: if false;
    }

    match /branchTransfers/{transferId} {
      allow read: if isStaff() &&
        (isMasterAdmin() ||
          resource.data.fromBranchId == managerBranchId() ||
          resource.data.toBranchId == managerBranchId());
      allow create: if isStaff() &&
        request.resource.data.fromBranchId != null &&
        canAccessBranch(request.resource.data.fromBranchId);
      allow update, delete: if false;
    }
  }
}
