rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMasterAdmin() {
      return request.auth != null &&
        request.auth.token.role == 'master-admin';
    }

    // Shared product images (online shop + inventory)
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Online shop homepage assets
    match /homepage/{allPaths=**} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}
